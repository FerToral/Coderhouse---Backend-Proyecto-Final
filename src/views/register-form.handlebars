<section class="auth-layout"><div><p class="eyebrow">Tu cuenta / CityCode</p><h1
    >Empezá<br />por acá.</h1><p class="lead">Creá tu cuenta y prepará tu
      carrito.</p></div>
  <form action="/register" method="post" class="auth-form"><h2>Crear cuenta</h2>{{#if
      msg
    }}<p role="alert">{{msg}}</p>{{/if}}
    <label for="firstName">Nombre</label><input
      id="firstName"
      name="firstName"
      autocomplete="given-name"
      required
      maxlength="100"
    />
    <label for="lastName">Apellido</label><input
      id="lastName"
      name="lastName"
      autocomplete="family-name"
      required
      maxlength="100"
    />
    <label for="email">Correo electrónico</label><input
      id="email"
      name="email"
      type="email"
      autocomplete="username"
      required
    />
    <label for="password">Contraseña</label><input
      id="password"
      name="password"
      type="password"
      minlength="8"
      autocomplete="new-password"
      required
    />
    <button class="button" type="submit">Crear mi cuenta →</button><a
      href="/login"
    >Ya tengo cuenta</a></form></section>