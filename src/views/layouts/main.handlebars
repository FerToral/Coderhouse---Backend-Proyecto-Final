<!doctype html>
<html lang="es">
  <head><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />
    <title>{{#if title}}{{title}}{{else}}CityCode · Ecommerce{{/if}}</title><link
      rel="stylesheet"
      href="/css/store.css"
    /></head>
  <body>
    <header class="site-header"><a class="brand" href="/products">city<span
        >code</span><small>objetos cotidianos</small></a>
      <nav aria-label="Principal"><a href="/products">Catálogo</a>
        {{#if sessionUser}}
          {{#unless isAdmin}}<a href="/chats/chat">Conversación</a>{{/unless}}
          {{#if isAdmin}}<a href="/users">Usuarios</a>{{/if}}
          {{#if sessionUser.cart}}<a href="/carts/{{sessionUser.cart}}">Mi
              carrito</a>{{/if}}
          <form action="/logout" method="post"><button
              class="text-button"
              type="submit"
            >Salir</button></form>
        {{else}}<a href="/login">Ingresar</a>{{/if}}
      </nav></header>
    <main id="contenido">{{{body}}}</main>
    <footer class="site-footer"><span>CityCode · Proyecto académico de Backend</span><span
      >Coderhouse / Comisión 43340 · 2023</span></footer>
  </body></html>
