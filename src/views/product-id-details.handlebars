<a class="back-link" href="/products">← Catálogo</a>
<article class="product-detail" data-cart="{{cartId}}"><div
    class="detail-mark"
    aria-hidden="true"
  >{{product.category}}</div><section><p
      class="eyebrow"
    >{{product.category}}</p><h1>{{product.title}}</h1><p
      class="lead"
    >{{product.description}}</p><p class="price">$ {{money product.price}}</p><p
    >{{product.stock}} unidades disponibles · Código {{product.code}}</p>
    {{#if cartId}}<button class="button" data-add="{{product._id}}">Agregar al
        carrito →</button>{{else}}<a class="button" href="/login">Ingresar para
        comprar</a>{{/if}}
    <p
      id="store-message"
      role="status"
      class="status-message"
      aria-live="polite"
    ></p></section></article><script src="/js/store.js" defer></script>