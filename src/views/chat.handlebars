<section class="chat-page">
  <p class="eyebrow">Comunidad CityCode</p>
  <h1>Conversación</h1>
  <p>Consultas e ideas entre clientes. Participás con tu cuenta:
    <strong>{{sessionUser.email}}</strong>.</p>
  <p class="muted">Los mensajes son visibles para los demás clientes conectados.
    No compartas datos privados. Se muestran los últimos cien.</p>
  <ol id="div-msgs" class="chat-messages" aria-label="Mensajes recientes"></ol>
  <p id="chat-status" role="status" aria-live="polite">Conectando con la
    conversación…</p>
  <form id="chat-form" class="chat-compose">
    <label for="input-msg">Tu mensaje</label>
    <textarea
      id="input-msg"
      name="message"
      rows="3"
      maxlength="1000"
      required
      aria-describedby="chat-help"
    ></textarea>
    <small id="chat-help">Hasta 1000 caracteres. El envío se confirma al
      guardar.</small>
    <button type="submit" class="button">Enviar mensaje</button>
  </form>
  <noscript>La conversación en tiempo real necesita JavaScript.</noscript>
</section>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/chat.js" defer></script>