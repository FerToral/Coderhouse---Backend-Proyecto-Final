# Copiar como .env.local; no reutilizar credenciales del historial.
NODE_ENV=development
PORT=8080
MONGO_URL=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0
# Generar localmente con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
API_URL=http://localhost:8080
# HOST usa loopback en desarrollo y todas las interfaces en producción.
# TRUST_PROXY=1 sólo detrás de un único proxy HTTPS que reescribe X-Forwarded-*.
TRUST_PROXY=0
# Rutas persistentes del servidor; no ubicarlas bajo src/public.
UPLOAD_ROOT=
LOG_DIR=
# OAuth y correo son opcionales en la ejecución local básica.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_EMAIL=
GOOGLE_PASS=
