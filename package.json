    "express": "^4.18.2",
    "express-handlebars": "^7.0.7",
    "express-session": "^1.17.3",
    "mongoose": "^7.2.3",
    "mongoose-paginate-v2": "^1.7.1",
    "multer": "2.4.0",
    "nodemailer": "10.1.7",
    "passport": "^0.6.0",
    "passport-github2": "^0.1.12",
    "passport-local": "^1.0.0",
